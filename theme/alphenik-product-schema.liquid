{%- comment -%}
  Alphenik — Product JSON-LD for Google merchant listings / rich results and AI answer engines.
  Adds: brand, sku, image list, per-variant offers with free UAE next-day shipping (shippingDetails),
  Judge.me aggregateRating when reviews exist. Return policy intentionally omitted until the store's
  return rules are decided (see Settings → Policies). Added 25 Oct 2026.
{%- endcomment -%}
{%- assign rating = product.metafields.reviews.rating.value -%}
{%- assign rating_count = product.metafields.reviews.rating_count | default: 0 -%}
{%- assign images = product.images -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ shop.url | append: product.url | json }},
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": "Alphenik" },
  "category": {{ product.type | json }},
  {%- if product.selected_or_first_available_variant.sku != blank %}"sku": {{ product.selected_or_first_available_variant.sku | json }},{% endif %}
  "image": [{% for image in images limit: 6 %}{{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  {%- if rating and rating_count > 0 %}
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rating.rating | json }}, "bestRating": {{ rating.scale_max | default: 5 | json }}, "ratingCount": {{ rating_count | json }} },
  {%- endif %}
  "offers": [
  {%- for variant in product.variants %}
    {
      "@type": "Offer",
      "url": {{ shop.url | append: variant.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ variant.price | money_without_currency | remove: ',' | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "seller": { "@type": "Organization", "name": "Alphenik" },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "AED" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "AE" },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
          "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY" }
        }
      }
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  ]
}
</script>
